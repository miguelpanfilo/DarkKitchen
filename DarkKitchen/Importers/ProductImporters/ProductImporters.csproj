<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\..\Contratos\Contract\Contract.csproj" />
        <ProjectReference Include="..\..\LogicaDeNegocioAbstracciones\BusinessLogicsAbstractions\BusinessLogicsAbstractions.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <Target Name="CopyPluginToApi" AfterTargets="Build">
        <MakeDir Directories="$(SolutionDir)DarkKitchenWebApi\bin\Debug\net8.0\plugins" />

        <Copy
                SourceFiles="$(TargetDir)$(TargetFileName)"
                DestinationFolder="$(SolutionDir)DarkKitchenWebApi\bin\Debug\net8.0\plugins" />
    </Target>

</Project>